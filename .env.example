# Copy to .env and fill in values. See DATABASE.md for Supabase connection details.
# Run: npm run check:env

# --- Database (required) ---
# Runtime: Supabase Transaction pooler (port 6543, user postgres.[project-ref], ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations only: direct connection (port 5432, user postgres)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# --- Supabase Auth (required) ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- App URL (required in production) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stripe (required for billing) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_LOCAL_PLUS="price_..."
STRIPE_PRICE_ELITE="price_..."
# Optional annual prices
# STRIPE_PRICE_STARTER_ANNUAL="price_..."
# STRIPE_PRICE_PRO_ANNUAL="price_..."
# STRIPE_PRICE_LOCAL_PLUS_ANNUAL="price_..."
# STRIPE_PRICE_ELITE_ANNUAL="price_..."

# --- Retell AI (required for call answering) ---
RETELL_API_KEY="key_..."
RETELL_AGENT_ID="agent_..."
RETELL_WEBHOOK_SECRET="whsec_..."
# RETELL_DEFAULT_AREA_CODE="415"
# RETELL_DEMO_AGENT_ID="agent_..."
# NEXT_PUBLIC_DEMO_NUMBER="+1..."

# --- Twilio (optional: SMS notifications) ---
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_PHONE_NUMBER="+1..."

# --- Email (optional: Resend) ---
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="notifications@callgrabbr.com"

# --- Cron jobs (Vercel) ---
# CRON_SECRET="random-secret"

# --- SEO / analytics (optional) ---
# GOOGLE_SITE_VERIFICATION="..."
# NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# --- Sentry (optional) ---
# SENTRY_DSN="..."
# NEXT_PUBLIC_SENTRY_DSN="..."
